get_normacro_metadata <- function() {
path <-
system.file(
"extdata",
"metadata.csv",
package = "NorMacro"
)
if (!nzchar(path)) {
stop(
"Fant ikke metadatafilen i den installerte NorMacro-pakken.",
call. = FALSE
)
}
readr::read_delim(
path,
delim = ";",
locale = readr::locale(
decimal_mark = ",",
grouping_mark = ".",
encoding = "UTF-8"
),
show_col_types = FALSE,
na = c("", "NA"),
trim_ws = TRUE
)
}
get_international_metadata <- function() {
path <-
system.file(
"extdata",
"metadata_international.csv",
package = "NorMacro"
)
if (!nzchar(path)) {
stop(
"Fant ikke metadatafilen for internasjonale data.",
call. = FALSE
)
}
readr::read_delim(
path,
delim = ";",
locale = readr::locale(
decimal_mark = ",",
grouping_mark = ".",
encoding = "UTF-8"
),
show_col_types = FALSE,
na = c("", "NA"),
trim_ws = TRUE
)
}
