advanced_api <- c(
"combine_series",
"growth",
"normalize",
"correlate",
"regress",
"autocorrelate"
)
for (fun in advanced_api) {
files <- list.files(
"R",
pattern = "\\.R$",
full.names = TRUE
)
hits <- vapply(
files,
function(file) {
any(
grepl(
paste0(
"^",
fun,
"\\s*<-\\s*function"
),
readLines(file, warn = FALSE)
)
)
},
logical(1)
)
cat(
"\n### ",
fun,
"\n",
paste(files[hits], collapse = "\n"),
"\n",
sep = ""
)
}
files <- unique(
unlist(
lapply(
advanced_api,
function(fun) {
all_files <- list.files(
"R",
pattern = "\\.R$",
full.names = TRUE
)
all_files[
vapply(
all_files,
function(file) {
any(
grepl(
paste0(
"^",
fun,
"\\s*<-\\s*function"
),
readLines(file, warn = FALSE)
)
)
},
logical(1)
)
]
}
)
)
)
for (file in files) {
cat("\n\n### ", file, "\n\n", sep = "")
cat(
head(
readLines(file, warn = FALSE),
40
),
sep = "\n"
)
}
