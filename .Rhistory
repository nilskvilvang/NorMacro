advanced_api <- c(
"combine_series",
"index",
"growth",
"normalize",
"correlate",
"regress",
"autocorrelate"
)
tibble::tibble(
Funksjon = advanced_api,
Eksportert =
advanced_api %in%
getNamespaceExports("NorMacro"),
Dokumentert =
paste0(advanced_api, ".Rd") %in%
list.files("man")
)
advanced_methods <- c(
"index.comparison_series",
"growth.comparison_series",
"normalize.comparison_series",
"correlate.comparison_series",
"regress.comparison_series",
"autocorrelate.comparison_series"
)
files <- list.files(
"R",
pattern = "\\.R$",
full.names = TRUE
)
for (fun in advanced_methods) {
cat("\n\n### ", fun, "\n", sep = "")
for (file in files) {
lines <- readLines(file, warn = FALSE)
hits <- grep(
paste0("^", fun, "\\s*<-\\s*function"),
lines
)
if (length(hits) > 0L) {
i <- hits[[1]]
from <- max(1L, i - 35L)
cat(file, "\n")
cat(
sprintf(
"%4d: %s\n",
from:i,
lines[from:i]
)
)
}
}
}
