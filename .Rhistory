project_files <- list.files(
".",
recursive = TRUE,
full.names = TRUE,
include.dirs = FALSE
)
text_files <- project_files[
grepl(
"\\.(R|Rmd|qmd|md|yml|yaml|DESCRIPTION|txt)$",
project_files,
ignore.case = TRUE
)
]
source_references <- lapply(text_files, function(file) {
lines <- tryCatch(
readLines(file, warn = FALSE, encoding = "UTF-8"),
error = function(e) character()
)
matches <- grep(
"source\\s*\\(",
lines,
value = TRUE
)
if (length(matches)) {
data.frame(
Fil = file,
Treff = matches,
stringsAsFactors = FALSE
)
}
})
dplyr::bind_rows(source_references)
