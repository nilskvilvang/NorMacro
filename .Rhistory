test_files <- list.files(
"tests/testthat",
pattern = "\\.R$",
full.names = TRUE
)
hits <- lapply(
test_files,
function(file) {
lines <- readLines(
file,
warn = FALSE,
encoding = "UTF-8"
)
matched <- grep(
"\\bkostra\\b",
lines,
value = TRUE
)
if (length(matched) > 0L) {
tibble::tibble(
Fil = file,
Linje = matched
)
}
}
)
dplyr::bind_rows(hits)
devtools::test()
