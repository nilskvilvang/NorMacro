x <- combine_series(
norway = c(
"Inflasjon",
"BNP_Fastland_vekst"
),
international = list(
SE = c(
"Inflasjon",
"BNP_vekst"
)
),
start_year = 2000,
end_year = 2025
)
class(x)
attributes(x)
head(x)
x_index <- index(
x,
base_year = 2000
)
class(x_index)
attributes(x_index)
head(x_index)
x_normalized <- normalize(
x,
base_year = 2000
)
class(x_normalized)
attributes(x_normalized)
head(x_normalized)
all.equal(
x_index,
x_normalized
)
x_growth <- growth(
x,
periods = 1,
percent = TRUE
)
class(x_growth)
attributes(x_growth)
head(x_growth)
correlate(
x_growth
)
autocorrelate(
x_growth,
lags = 1:3
)
unique(x_growth$Serie_id)
